PORT=3000
HOST=0.0.0.0
API_KEY=
PUBLIC_BASE_URL=https://example.ngrok-free.app

# SignalWire Compatibility API credentials.
SIGNALWIRE_BASE_URL=https://{space}.signalwire.com/api/laml/2010-04-01
SIGNALWIRE_PROJECT_ID=00000000-0000-0000-0000-000000000000
SIGNALWIRE_TOKEN=your-api-token
SIGNALWIRE_FROM=+493023125001

# Optional default destination for POST /calls when no "to" is provided.
DEFAULT_TO=+492214710000
TEST_TIMEOUT_MS=120000

# SignalWire XML returned when the outbound test call is answered.
SIGNALWIRE_SAY_MESSAGE=SignalWire webhook test connected successfully.

# Optional shared secret configured in Placetel External APIs.
PLACETEL_SHARED_SECRET=

# Placetel control behavior for incoming calls to the Placetel number.
# Supported: forward, reject, busy, hangup, prompt, group, routing_plan, queue
PLACETEL_ACTION=hangup
PLACETEL_FORWARD_TARGETS=
PLACETEL_FORWARD_RINGTIME=30
PLACETEL_PROMPT_ID=
PLACETEL_GROUP_ID=
PLACETEL_ROUTING_PLAN_ID=
PLACETEL_QUEUE_ID=

# Optional basic auth for local admin/call endpoints.
ADMIN_USERNAME=
ADMIN_PASSWORD=
